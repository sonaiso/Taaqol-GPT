{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taaqol-gpt.local/schemas/z0_legacy_remap.schema.json",
  "title": "Z0LegacyRemapLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "law_ref",
    "legacy_baseline_sha",
    "scope_manifest_ref",
    "remap_states",
    "target_z0_stage_registry",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "law_ref": {
      "type": "string",
      "const": "docs/112_ZERO_CONSTITUTION_REFOUNDATION_LAW.md"
    },
    "legacy_baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope_manifest_ref": {
      "type": "string",
      "pattern": "^data/.+\\.json$"
    },
    "remap_states": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "KEEP",
          "RETYPE",
          "REORDER",
          "QUARANTINE",
          "REBUILD"
        ]
      }
    },
    "target_z0_stage_registry": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/TargetZ0Stage"
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/LegacyRemapRecord"
      }
    }
  },
  "$defs": {
    "TargetZ0Stage": {
      "type": "string",
      "enum": [
        "REALITY_OPEN",
        "TRACE_AND_PRIOR_KNOWLEDGE",
        "UNIT",
        "IDENTITY",
        "MCE",
        "DAL_GEOMETRY",
        "EXHAUSTED_WORD_FORM_GEOMETRY",
        "SEMANTIC_BRANCH",
        "FORMAL_COMPOSITION_BRANCH",
        "PRE_IFADAH_CONCEPTUAL_CLOSURE",
        "IFADAH",
        "MANTUQ",
        "MAFHUM",
        "HUKM",
        "REALITY_CLOSE",
        "LEGACY_HISTORICAL_ONLY"
      ]
    },
    "ProofStatusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requirement_ref",
        "proof_ref"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PROVEN",
            "REFUSED"
          ]
        },
        "requirement_ref": {
          "type": "string",
          "pattern": "^docs/.+\\.md(#.+)?$"
        },
        "proof_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^docs/.+\\.md(#.+)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROVEN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "proof_ref": {
                "type": "string",
                "pattern": "^docs/.+\\.md(#.+)?$"
              }
            },
            "required": [
              "proof_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PENDING",
                  "REFUSED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "proof_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "LegacyRemapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "artifact_atomicity",
        "members",
        "source_law",
        "source_module",
        "legacy_predecessors",
        "legacy_successors",
        "target_z0_stage",
        "target_substage",
        "remap_state",
        "remap_status",
        "backward_proof",
        "forward_readiness",
        "triangle_coherence",
        "authority_before",
        "authority_after",
        "residuals",
        "replacement_artifact",
        "trace_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "KERNEL",
            "RUNTIME_STAGE",
            "CARRIER",
            "VERDICT",
            "GATE",
            "INTEGRATION"
          ]
        },
        "artifact_atomicity": {
          "type": "string",
          "enum": [
            "ATOMIC",
            "BUNDLE"
          ]
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_law": {
          "type": "string",
          "pattern": "^docs/.+\\.md$"
        },
        "source_module": {
          "type": "string",
          "pattern": "^(src/.+\\.py|docs/.+\\.md)$"
        },
        "legacy_predecessors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacy_successors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_z0_stage": {
          "$ref": "#/$defs/TargetZ0Stage"
        },
        "target_substage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "remap_state": {
          "type": "string",
          "enum": [
            "KEEP",
            "RETYPE",
            "REORDER",
            "QUARANTINE",
            "REBUILD"
          ]
        },
        "remap_status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PROVEN"
          ]
        },
        "backward_proof": {
          "$ref": "#/$defs/ProofStatusRecord"
        },
        "forward_readiness": {
          "$ref": "#/$defs/ProofStatusRecord"
        },
        "triangle_coherence": {
          "$ref": "#/$defs/ProofStatusRecord"
        },
        "authority_before": {
          "type": "string",
          "minLength": 1
        },
        "authority_after": {
          "type": "string",
          "minLength": 1
        },
        "residuals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacement_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_atomicity": {
                "const": "ATOMIC"
              }
            },
            "required": [
              "artifact_atomicity"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_atomicity": {
                "const": "BUNDLE"
              }
            },
            "required": [
              "artifact_atomicity"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remap_state": {
                "const": "REBUILD"
              }
            },
            "required": [
              "remap_state"
            ]
          },
          "then": {
            "properties": {
              "replacement_artifact": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "replacement_artifact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "remap_state": {
                "const": "QUARANTINE"
              }
            },
            "required": [
              "remap_state"
            ]
          },
          "then": {
            "properties": {
              "target_z0_stage": {
                "const": "LEGACY_HISTORICAL_ONLY"
              }
            },
            "required": [
              "target_z0_stage"
            ]
          }
        }
      ]
    }
  }
}
