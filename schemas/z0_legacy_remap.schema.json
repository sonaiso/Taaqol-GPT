{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taaqol-gpt.local/schemas/z0_legacy_remap.schema.json",
  "title": "Z0LegacyRemapLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "law_ref",
    "remap_states",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "law_ref": {
      "type": "string",
      "const": "docs/112_ZERO_CONSTITUTION_REFOUNDATION_LAW.md"
    },
    "remap_states": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "KEEP",
          "RETYPE",
          "REORDER",
          "QUARANTINE",
          "REBUILD"
        ]
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/LegacyRemapRecord"
      }
    }
  },
  "$defs": {
    "LegacyRemapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "source_law",
        "source_module",
        "legacy_predecessors",
        "legacy_successors",
        "target_z0_stage",
        "remap_state",
        "backward_proof_ref",
        "forward_readiness_ref",
        "triangle_coherence_ref",
        "authority_before",
        "authority_after",
        "residuals",
        "replacement_artifact",
        "trace_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "KERNEL",
            "RUNTIME_STAGE",
            "CARRIER",
            "VERDICT",
            "GATE",
            "INTEGRATION"
          ]
        },
        "source_law": {
          "type": "string",
          "pattern": "^docs/.+\\.md$"
        },
        "source_module": {
          "type": "string",
          "pattern": "^(src/.+\\.py|docs/.+\\.md)$"
        },
        "legacy_predecessors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacy_successors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_z0_stage": {
          "type": "string",
          "minLength": 1
        },
        "remap_state": {
          "type": "string",
          "enum": [
            "KEEP",
            "RETYPE",
            "REORDER",
            "QUARANTINE",
            "REBUILD"
          ]
        },
        "backward_proof_ref": {
          "type": "string",
          "minLength": 1
        },
        "forward_readiness_ref": {
          "type": "string",
          "minLength": 1
        },
        "triangle_coherence_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority_before": {
          "type": "string",
          "minLength": 1
        },
        "authority_after": {
          "type": "string",
          "minLength": 1
        },
        "residuals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacement_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
