{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/governance/slge_sdlc_current_lifecycle_state.schema.json",
  "title": "SLGE-SDLC Current Lifecycle State Projection",
  "type": "object",
  "required": [
    "version",
    "projection_id",
    "branch_ref",
    "derived_from",
    "projection_metadata",
    "current_lifecycle_states"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "projection_id": { "type": "string", "minLength": 1 },
    "branch_ref": { "const": "SLGE-SDLC-P0" },
    "derived_from": {
      "type": "object",
      "required": ["registry", "temporal_cut"],
      "properties": {
        "registry": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "temporal_cut": {
          "type": "object",
          "required": ["cut_id", "minimum_governance_order", "minimum_dependency_order"],
          "properties": {
            "cut_id": { "const": "T_SLGE" },
            "minimum_governance_order": { "type": "integer" },
            "minimum_dependency_order": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projection_metadata": {
      "type": "object",
      "required": [
        "projector_algorithm_id",
        "reduction_contract",
        "authoritative_inputs",
        "source_fingerprints",
        "origin_refs",
        "runtime_ref"
      ],
      "properties": {
        "projector_algorithm_id": { "type": "string", "minLength": 1 },
        "reduction_contract": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "authoritative_inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "origin_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtime_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "current_lifecycle_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "lineage_id",
          "current_lifecycle_slot",
          "baseline_ref",
          "last_applied_event",
          "maturity_coordinates",
          "rank_ceiling",
          "authority_ceiling",
          "open_residual_refs",
          "trace_refs",
          "allowed_next_openings",
          "historical_uncertainty_boundary"
        ],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "lineage_id": { "type": "string", "minLength": 1 },
          "current_lifecycle_slot": { "type": "string", "minLength": 1 },
          "baseline_ref": { "type": ["string", "null"] },
          "last_applied_event": { "type": ["string", "null"] },
          "maturity_coordinates": {
            "type": "object",
            "required": [
              "LifecycleSlot",
              "EpistemicRank",
              "ConstitutionalMaturity",
              "RuntimeMaturity",
              "ReleaseMaturity",
              "GeneralityScope"
            ],
            "properties": {
              "LifecycleSlot": { "type": "string", "minLength": 1 },
              "EpistemicRank": { "type": "string", "minLength": 1 },
              "ConstitutionalMaturity": { "type": "string", "minLength": 1 },
              "RuntimeMaturity": { "type": "string", "minLength": 1 },
              "ReleaseMaturity": { "type": "string", "minLength": 1 },
              "GeneralityScope": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "rank_ceiling": { "type": "string", "minLength": 1 },
          "authority_ceiling": { "type": "string", "minLength": 1 },
          "open_residual_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "trace_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "allowed_next_openings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "historical_uncertainty_boundary": {
            "type": "object",
            "required": ["status", "historical_mclt_ref", "legacy_boundary_preserved"],
            "properties": {
              "status": { "type": "string", "minLength": 1 },
              "historical_mclt_ref": { "type": ["string", "null"] },
              "legacy_boundary_preserved": { "type": "boolean" },
              "baseline_origin_ref": { "type": "string" },
              "decision_ref": { "type": "string" },
              "event_ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
